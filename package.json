{
  "name": "csv-insight-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch server/dev.ts",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "seed:samples": "node --import tsx scripts/seed-samples.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "cleanup:orphans": "node --import tsx scripts/cleanup-orphans.ts",
    "verify:samples": "node --import tsx scripts/verify-samples.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.23.0",
    "@clerk/react": "6.17.6",
    "@hono/node-server": "2.1.3",
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "@vercel/blob": "2.8.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "echarts": "6.1.0",
    "hono": "4.13.13",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/node": "21.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
