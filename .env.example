# Local development is bound to loopback and never allowed on Vercel.
APP_MODE=local
VITE_APP_MODE=local
APP_ORIGIN=http://localhost:5173
LOCAL_DATA_DIR=.local
# Production requires every service below. Never prefix secrets with VITE_.
DATABASE_URL=
DATABASE_MIGRATION_URL=
BLOB_READ_WRITE_TOKEN=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
ENABLE_AI_SUMMARY=false
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=50000
MAX_COLUMNS=500
MAX_CELLS=2000000
ANALYSIS_TIMEOUT_MS=110000
DAILY_ANALYSIS_LIMIT=20
